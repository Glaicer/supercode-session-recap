{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@glaicer/supercode-session-recap",
  "version": "1.0.0",
  "description": "OpenCode V2 plugin that shows a short Recap of a completed root session in the TUI sidebar without writing it to History.",
  "type": "module",
  "license": "MIT",
  "author": "Dmitrii Aronov <aronov.mml@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glaicer/supercode-session-recap.git"
  },
  "homepage": "https://github.com/Glaicer/supercode-session-recap#readme",
  "bugs": {
    "url": "https://github.com/Glaicer/supercode-session-recap/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui-plugin",
    "session-recap"
  ],
  "exports": {
    ".": "./dist/server.js",
    "./rpc": "./dist/rpc.js",
    "./tui": "./dist/recap.js"
  },
  "files": [
    "dist",
    "index.js",
    "tui.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build && npm run check:package",
    "test": "node --test '*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.16"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "2.0.16",
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@types/node": "24.13.3",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=24",
    "opencode": ">=2.0.0"
  }
}
